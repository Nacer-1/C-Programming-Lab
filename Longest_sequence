#include <stdio.h>

int main()
{
    int n, i, x;
    int length = 0, best_length = 0;  
    int start = 0, best_start = 0;     
    int T[100];

    do {
        printf("Enter the array length: ");
        scanf("%d", &n);
    } while (n < 1 || n > 100);

    for (i = 0; i < n; i++) {
        printf("T[%d] = ", i);
        scanf("%d", &T[i]);
    }

    printf("Enter the number X: ");
    scanf("%d", &x);

    for (i = 0; i < n; i++) {
        if (T[i] == x) {
            if (length == 0) {
                start = i;
            }
            length++;
            if (length > best_length) {
                best_length = length;
                best_start = start;
            }
        } else {
            length = 0;
        }
    }

    if (best_length == 0)
        printf("The integer %d does not exist in the array.\n", x);
    else
        printf("The longest consecutive run of %d has length %d and starts at index %d.\n",
               x, best_length, best_start);

    return 0;
}
