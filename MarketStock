#include <stdio.h>
#include <stdlib.h>

int main()
{
    int i, j, k, rayon, Produit, quantite, rayon_Mettre_jour, Produit_Mettre_jour, choix, min, n;
    int debut, fin, milieu, trouve;
    float aux, valeur;

    n=0;

    do{
        printf("Donne le nombre de rayons: ");
        scanf("%d", &rayon);

        printf("Donne le nombre de Produit: ");
        scanf("%d", &Produit);

    }while(Produit<=0 || rayon<=0);

    int M[rayon][Produit];
    int T[Produit];
    float prix[Produit];
    float PT[Produit];

    for(j=0;j<Produit;j++){
        T[j]=0;
        prix[j]=0;
    }

    for(i=0;i<rayon;i++){
        for(j=0;j<Produit;j++){
            printf("Remplire M[%d][%d]:",i,j);
            scanf("%d", &M[i][j]);
        }
    }

    do{
        printf("\n -----Menu----- \n");
        printf("[1]Affiche les rayons et les Produit \n");
        printf("[2]Mettre a jour la quantite d'un produit donne dans un rayon donne \n");
        printf("[3]Calculer et afficher la quantite totale de chaque produit \n");
        printf("[4]Saisir le prix unitaire de chaque produit \n");
        printf("[5]Prix totaux: supprimer les zeros et trier \n");
        printf("[6]Rechercher une valeur dans les prix totaux \n");
        printf("[0]Quitter \n");
        printf("Choix: ");
        scanf("%d", &choix);

        switch(choix){

        case 1:
            printf("Affichage de rayons... \n");
            for(i=0;i<rayon;i++){
                for(j=0;j<Produit;j++){
                    printf("Rayons[%d] Produit[%d] = %d\n",i ,j ,M[i][j]);
                }
            }
            break;

        case 2:
            printf("Mettre a jour produit (0 a %d): \n", Produit-1);
            scanf("%d", &Produit_Mettre_jour);

            printf("Mettre a jour rayon (0 a %d): \n", rayon-1);
            scanf("%d", &rayon_Mettre_jour);

            if(Produit_Mettre_jour<0 || Produit_Mettre_jour>=Produit ||
               rayon_Mettre_jour<0 || rayon_Mettre_jour>=rayon){
                printf("Indice invalide !\n");
                break;
            }

            printf("Donner la quantite: \n");
            scanf("%d", &quantite);

            M[rayon_Mettre_jour][Produit_Mettre_jour]=quantite;
            break;

        case 3:
            for(j=0;j<Produit;j++){
                T[j]=0;
                for(i=0;i<rayon;i++){
                    T[j]=T[j]+M[i][j];
                }
                printf("Quantite totale du produit %d = %d\n", j, T[j]);
            }
            break;

        case 4:
            for(j=0;j<Produit;j++){
                do{
                    printf("Saisir le prix du produit %d: ", j);
                    scanf("%f",&prix[j]);
                }while(prix[j]<0);
            }
            break;

        case 5:
            for(j=0;j<Produit;j++){
                T[j]=0;
                for(i=0;i<rayon;i++){
                    T[j]=T[j]+M[i][j];
                }
                PT[j]=T[j]*prix[j];
            }
            n=Produit;

            j=0;
            while(j<n){
                if(PT[j]==0){
                    for(k=j;k<n-1;k++){
                        PT[k]=PT[k+1];
                    }
                    n=n-1;
                }else{
                    j=j+1;
                }
            }

            for(i=0;i<n-1;i++){
                min=i;
                for(j=i+1;j<n;j++){
                    if(PT[j]<PT[min]){
                        min=j;
                    }
                }
                if(min!=i){
                    aux=PT[i];
                    PT[i]=PT[min];
                    PT[min]=aux;
                }
            }

            printf("Prix totaux tries (%d valeurs):\n", n);
            for(j=0;j<n;j++){
                printf("%.2f\n", PT[j]);
            }
            break;

        case 6:
            if(n<=0){
                printf("Fais d'abord l'option 5 (ou tableau vide).\n");
                break;
            }
            printf("Valeur a chercher: ");
            scanf("%f", &valeur);

            debut=0;
            fin=n-1;
            trouve=0;
            while(debut<=fin && trouve==0){
                milieu=(debut+fin)/2;
                if(PT[milieu]==valeur){
                    trouve=1;
                }else if(valeur<PT[milieu]){
                    fin=milieu-1;
                }else{
                    debut=milieu+1;
                }
            }

            if(trouve==1)
                printf("%.2f existe (indice %d).\n", valeur, milieu);
            else
                printf("%.2f n'existe pas.\n", valeur);
            break;

        case 0:
            printf("Au revoir.\n");
            break;

        default:
            printf("Choix invalide.\n");
        }

    }while(choix!=0);

    return 0;
}
