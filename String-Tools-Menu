#include <stdio.h>
#include <string.h>

/* Safe replacement for gets(): reads a line and strips the newline */
static void read_line(char *buf, size_t size)
{
    if (fgets(buf, (int)size, stdin) == NULL) {
        buf[0] = '\0';
        return;
    }
    buf[strcspn(buf, "\n")] = '\0';
}

/* Reads an integer safely (no infinite loop on bad input) */
static int read_int(void)
{
    char line[32];
    int n;
    read_line(line, sizeof line);
    if (sscanf(line, "%d", &n) != 1) return -1;
    return n;
}

int main(void)
{
    int i, j, k, choice, count, s;
    char sentence[100], word_in[100], word[100], vowel_list[200];
    const char vowels[] = {'A','E','I','O','U','Y','a','e','i','o','u','y'};

    do {
        do {
            printf("\n");
            printf("**********Menu**********\n");
            printf("[1]: Display the words of a sentence.\n");
            printf("[2]: Display the vowels of a word and how many there are.\n");
            printf("[3]: Build a sentence.\n");
            printf("[0]: Quit...\n");
            printf("************************\n\n");
            choice = read_int();
        } while (choice > 3 || choice < 0);

        switch (choice) {
        case 1:
            printf("Enter a sentence: ");
            read_line(sentence, sizeof sentence);
            printf("\n");
            s = 0;
            j = 0;
            for (i = 0; i <= (int)strlen(sentence); i++) {
                if (sentence[i] != ' ' && sentence[i] != '\0' && sentence[i] != '.') {
                    word[j++] = sentence[i];
                } else if (j > 0) {
                    word[j] = '\0';
                    s++;
                    printf("word %d: %s\n", s, word);
                    j = 0;
                }
            }
            if (s == 0)
                printf("This is not a sentence\n");
            break;

        case 2:
            printf("Enter a word: ");
            read_line(word_in, sizeof word_in);
            printf("\n");
            j = 0;
            count = 0;
            for (i = 0; i < (int)strlen(word_in); i++) {
                for (k = 0; k < 12; k++) {
                    if (word_in[i] == vowels[k]) {
                        count++;
                        vowel_list[j++] = word_in[i];
                        vowel_list[j++] = ' ';
                        break;
                    }
                }
            }
            vowel_list[j] = '\0';

            if (count == 0)
                printf("The word contains no vowels\n");

            printf("\nVowel list: { %s }\n", vowel_list);
            printf("Number of vowels in [ %s ]: %d\n\n", word_in, count);
            break;

        case 3:
        {
            /* Correct sentence: "it's our sixth toast for this year" */
            char words[7][20] = {"sixth", "our", "for", "it's", "year", "toast", "this"};
            int correct[7] = {3, 2, 5, 1, 7, 4, 6};
            int ord[7];
            int ok = 1;

            printf("Here are the words:\n");
            for (i = 0; i < 7; i++)
                printf("\"%s\" ", words[i]);
            printf("\n");

            for (i = 0; i < 7; i++) {
                do {
                    printf("Enter the position of the word \"%s\" in the sentence: ", words[i]);
                    ord[i] = read_int();
                } while (ord[i] < 1 || ord[i] > 7);

                if (ord[i] != correct[i]) ok = 0;
            }

            if (ok) {
                for (i = 1; i <= 7; i++) printf("%d\t", i);
                printf("\nWell done, that's the right answer!\n");
                printf("The sentence is: ");
            } else {
                printf("\nThe sentence ");
            }

            for (j = 1; j <= 7; j++)
                for (i = 0; i < 7; i++)
                    if (ord[i] == j)
                        printf("%s ", words[i]);

            if (!ok) printf("makes no sense");
            printf("\n");
            break;
        }
        }
    } while (choice != 0);

    return 0;
}
