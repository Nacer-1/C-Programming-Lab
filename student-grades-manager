#include <stdio.h>
#include <math.h>
#include <time.h>
#include <string.h>

int main(){

    int n, i;
    float note[30];
    int note2[30];

    do{
        printf("Donne le nombre de etudion:");
        scanf("%d", &n);
    }while( n > 30 || n < 1);

    printf("\n");

    for(i=0 ; n > i ; i++){

        do{
            printf("Donne les note de [ %d ] etudion: ", i+1);
            scanf("%f", &note[i]);
        }while(note[i] > 20 || note[i] < 0 );

    }

    printf("\n");

    printf("-----|Clasmon les etudion|-----\n");

    for(i=0 ; n > i ; i++){

        if(note[i] < 10){
            printf("Etudion a Un moyen de [ %.2f ] Numero[%d]: Ajourne !\n",note[i], i);
        }else if(note[i] < 12){
            printf("Etudion a Un moyen de [ %.2f ] Numero[%d]: Passable \n",note[i], i);
        }else if(note[i] < 14){
            printf("Etudion a Un moyen de [ %.2f ] Numero[%d]: Assez bien \n",note[i], i);
        }else if(note[i] < 16){
            printf("Etudion a Un moyen de [ %.2f ] Numero[%d]: Bien \n",note[i], i);
        }else{
            printf("Etudion a Un moyen de [ %.2f ] Numero[%d]: Tres bien :) \n",note[i], i);
        }
        note2[i]=note[i];
    }

    printf("\n");    printf("\n");

    int choix,j,min;
    float aux;
    float min_moyen, max_moyen;
    int pos_min, pos_max;

    do{

        do{

            printf("---------- |Menu-De-Affichage| ----------\n");
            printf("[1]|Afficher les Note trie.\n");
            printf("[2]|Afficher les Note Min/Max.\n");
            printf("[3]Quitter 'Menu-De-Affichage'.\n");
            scanf("%d", &choix);
        }while(choix < 1 || choix > 3);

        switch(choix){

        case 2:

            min_moyen=note2[0];
            max_moyen=note2[0];
            pos_min=0;
            pos_max=0;

            for(i=0 ; n > i ; i++){
                if(note2[i] > max_moyen){
                    max_moyen=note2[i];
                    pos_max=i;
                }
                if(note2[i] < min_moyen){
                    min_moyen=note2[i];
                    pos_min=i;
                }
            }

            printf("Le MAX:%.2f (position %d)\n", max_moyen, pos_max);
            printf("Le MIN:%.2f (position %d)\n", min_moyen, pos_min);
            printf("\n");

            break;

        case 1:

            for(i=0 ; n-1 > i ; i++){
                min=i;
                for(j=i+1 ; n > j ; j++ ){
                    if(note[j] < note[min]){
                        min=j;
                    }
                }
                if(min!=i){
                    aux=note[min];
                    note[min]=note[i];
                    note[i]=aux;
                }
            }
            for(i=0 ; n > i ; i++){
                printf("Tablo de Note des eleve : [%d | %.2f]\n", i, note[i]);
            }
                printf("\n");
            break;

        case 3:
            printf("Au revoir !!!");
            break;

        }

    }while(choix!=3);

    printf("\n");
    return 0;
}
