#include <stdio.h>

int main(void) {
    int sticks, take, player = 1, i;

    do {
        printf("Enter number of sticks: ");
        scanf("%d", &sticks);
    } while (sticks <= 0);

    for (i = 0; i < sticks; i++) printf("I");
    printf("\n");

    while (sticks > 0) {

        do {
            printf("Player %d, enter the number of sticks to take: ", player);
            scanf("%d", &take);
        } while (take < 1 || take > 3 || take > sticks);

        sticks = sticks - take;

        for (i = 0; i < sticks; i++) printf("I");
        printf("\n");

        if (sticks == 0) {
            printf("Player %d took the last stick: they lose the round!\n", player);
            printf("Player %d wins!\n", 3 - player);
        } else {
            player = 3 - player;
        }
    }

    return 0;
}
